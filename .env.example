# =========================================================
# 校园食安推广方案站 —— 环境变量样例
# 复制为 backend/.env 后按实际环境修改（禁止提交 .env 入库）
# =========================================================

# ===== 运行环境 =====
NODE_ENV=development
PORT=3000

# 本地开发时由 Express 同源托管静态资源；生产由 Caddy 托管 dist/，设为 false
SERVE_STATIC=true

# ===== 数据库（PostgreSQL）=====
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/foodsafety_outreach

# ===== 安全密钥 =====
# 生成：openssl rand -base64 48
JWT_SECRET=
# 访问令牌有效期（后台登录）
JWT_EXPIRE=8h

# ===== 跨域白名单（禁止使用通配符 *）=====
# 生产示例：CORS_ORIGIN=https://your.domain,http://111.231.166.161:8080
CORS_ORIGIN=

# ===== 初始管理员（首次 seed 时使用；seed 后请从 .env 移除或轮换）=====
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=平台管理员

# ===== 限流 =====
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_FAIL_LOCK_THRESHOLD=5
LOGIN_FAIL_LOCK_WINDOW_MS=900000

# ===== 请求体上限 =====
BODY_LIMIT=2mb

# ===== 其它 =====
AUTO_SEED_CONTENT=true

# ===== 钉钉群机器人通知（可选）=====
# 新留言实时推送到钉钉运营群；不配置则通知链路关闭，不影响留言落库
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxx
# 机器人安全方式二选一：「自定义关键词」填「留言」即可（代码已内置该词）；「加签」则填写下方密钥
# DINGTALK_SECRET=
