node_modules/
dist/
coverage/

# 环境变量（含密钥，绝不入库）
.env
.env.*
!.env.example

# 运行时产物
backend/uploads/
backend/backups/
logs/
*.log

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json

# 测试产物
cypress/screenshots/
cypress/videos/

# ===== 生产部署私有配置（真实域名/路径/数据库参数，禁止入库）=====
deploy/deploy.conf
deploy/deploy.prod.conf
deploy/deploy.*.local.conf

# ===== 私钥 / 证书 / 数据库转储 =====
*.pem
*.key
*.dump
*.sql.gz

# 工具缓存（Prisma 引擎二进制、npm 缓存等，体积大且平台相关）
.cache/
.npm/

# CodeBuddy 工作数据（记忆、自动化任务等，属本机数据不入库；
# 同时避免 deploy.sh 的 git clean -fd 每次部署将其删除）
.codebuddy/
